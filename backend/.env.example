# Copy this file to .env and adjust values as needed.

# --- Database ---
DATABASE_URL=sqlite:///./trustguard.db

# --- App ---
# development: unset API keys leave admin endpoints open (local demo). production: they are refused.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Access control (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))") ---
# Protects device registration, machine/sensor create+delete, alert resolve, maintenance updates.
ADMIN_API_KEY=9aq3sgVnoWW2tdG0NsXlaYqcFz_rnO42bsw3ufXXZVs
# Required by devices using the HTTP fallback (POST /api/hardware/ingest). Not used for MQTT.
DEVICE_API_KEY=0h1j1b-rPMukyF-e0nnMT07ML8HZBg4pxjrcOmYMeUQ

# --- MQTT (real hardware) ---
# Must match your Mosquitto configuration (see docs/MQTT.md). Wrong or inconsistent values are reported in
# GET /api/hardware/broker and in the log instead of crashing the backend.
MQTT_ENABLED=true
# Broker address as seen from THIS computer (the ESP32 uses the broker's LAN address instead). No "mqtt://" prefix.
MQTT_BROKER_HOST=q72067c0.ala.asia-southeast1.emqxsl.com
# 1883 = plain text (local development), 8883 = TLS. Leave empty to pick the default for MQTT_TLS.
MQTT_BROKER_PORT=8883
MQTT_BASE_TOPIC=trustguard/sensors
# Must exist in the broker's password file when the broker has allow_anonymous false. Leave both empty for an anonymous broker.
MQTT_USERNAME=backenduser
MQTT_PASSWORD=Arun1234
# TLS: set true only if the broker has a TLS listener (usually 8883). MQTT_CA_CERTS = path to the broker's CA file.
# With MQTT_TLS=false nothing is encrypted and the CA setting is ignored; the dashboard then shows "TLS off".
MQTT_TLS=true
MQTT_CA_CERTS=
# Optional tuning. The client id must be unique among everything connected to the broker.
MQTT_CLIENT_ID=trustguard-backend
MQTT_KEEPALIVE_SECONDS=30
# Messages per second the backend will process; extra ones are dropped and counted (0 = unlimited).
MQTT_MAX_MESSAGES_PER_SECOND=100

# --- Device health / data quality thresholds (seconds) ---
DEVICE_STALE_SECONDS=30
DEVICE_OFFLINE_SECONDS=120
DELAYED_AFTER_SECONDS=30
MAX_READING_AGE_SECONDS=3600

# --- Calibration of REAL hardware readings (see docs/HARDWARE_SETUP.md; compute with tools/calibrate_baseline.py) ---
# calibrated = raw * scale + offset; key = sensor type or "DEVICE_ID:sensor_type". Empty = no calibration.
SENSOR_CALIBRATION=

# --- Production safety: with APP_ENV=production the MQTT bridge refuses to start without TLS + credentials ---
ALLOW_INSECURE_MQTT=false

# --- Telegram bot (alerts + on-demand status). Setup: docs/TELEGRAM_BOT.md ---
TELEGRAM_ENABLED=false
# From @BotFather. Keep it secret; never commit it.
TELEGRAM_BOT_TOKEN=8865745820:AAGOoX7bX_D0aBHE5SoiI5aYq-m2kvQnrVw
# Comma-separated chat ids allowed to receive alerts and use commands (find yours by sending /chatid to the bot).
# Empty = nobody is authorised.
TELEGRAM_ALLOWED_CHAT_IDS=1458382836,8443270865
# Minimum minutes between pushes for the same machine + alert type (stops spam from a flapping sensor).
TELEGRAM_ALERT_COOLDOWN_MINUTES=10
# info | warning | critical
TELEGRAM_MIN_SEVERITY=warning
# false = push only for real hardware; simulated demo data stays quiet (commands still work).
TELEGRAM_NOTIFY_SIMULATED=true
# Optional link added to push messages, e.g. http://192.168.1.20:5173
TELEGRAM_DASHBOARD_URL=
TELEGRAM_CHECK_INTERVAL_SECONDS=15
